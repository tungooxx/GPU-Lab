ANTHROPIC_API_KEY=
CROSSREF_API_KEY=
GPU_LAB_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,chucky-lab.com
# Separate secret required to create parameter-bound human approval records.
GPU_LAB_APPROVAL_SECRET=
# Verified VRC runtime name: Python 3.13 + PyTorch 2.6.0+cu124, saved predictions maxabs=0.
# Create/select it explicitly through local_env_prepare(..., python_executable="python3.13").
GPU_LAB_CANONICAL_VRC_ENV=vrc-py313-torch260-cu124
GPU_LAB_DATABASE_URL=sqlite:///./data/gpu_lab.db
GPU_LAB_DATA_DIR=./data
GPU_LAB_ENABLE_LOCAL_RUNNER=false
GPU_LAB_ENABLE_REMOTE_EXEC=false
# Automatic pgvector secondary index. local-hash is private, deterministic, and needs no API key.
GPU_LAB_EMBEDDING_PROVIDER=local-hash
GPU_LAB_EMBEDDING_DIMENSION=384
# Optional typed LLM operators run inside the isolated literature worker.
GPU_LAB_RESEARCH_OPERATOR_PROVIDER=disabled
# Optional MIT Paper2Agent subprocess worker. Use a random worker token and a task-scoped
# Anthropic key; the base gateway never receives ANTHROPIC_API_KEY.
GPU_LAB_EXECUTABLE_PAPER_PROVIDER=disabled
GPU_LAB_EXECUTABLE_PAPER_WORKER_TOKEN=
GPU_LAB_EXECUTABLE_PAPER_WORKER_URL=http://paper2agent-relay:8020
# Optional Apache-2.0 PaperQA v5+ adapter. Keep disabled in the base gateway unless the
# isolated literature dependency and its task-scoped model credentials are configured.
GPU_LAB_LITERATURE_PROVIDER=disabled
GPU_LAB_LITERATURE_WORKER_TOKEN=
GPU_LAB_LITERATURE_WORKER_URL=http://literature-relay:8010
# Optional worker-only provider file. The MCP gateway never reads or exposes it.
GPU_LAB_LITERATURE_ENV_FILE=F:/Newgeneration/VLM/.env
# Optional OpenAI-compatible PaperQA endpoint. Configure all values together.
GPU_LAB_PAPERQA_BASE_URL=
GPU_LAB_PAPERQA_MODEL=
GPU_LAB_PAPERQA_EMBEDDING_MODEL=
GPU_LAB_PAPERQA_MAX_RETRIES=2
GPU_LAB_LOCAL_ENV_ROOT=/opt/gpu-lab/envs
GPU_LAB_LOCAL_WORKSPACE=/workspace/local-vlm
GPU_LAB_LOCAL_WORKSPACE_HOST=./local-vlm
GPU_LAB_MAX_LOG_LINES=1000
GPU_LAB_MAX_TEXT_ARTIFACT_BYTES=1048576
GPU_LAB_PAPERQA_DIRECTORY=/opt/gpu-lab/papers
GPU_LAB_REMOTE_ROOT=/workspace/GPU-Lab
GPU_LAB_RESEARCH_DATABASE_URL=postgresql://research:${POSTGRES_PASSWORD}@postgres:5432/research_os
# Research Policy Lab is bounded by default: proposals auto-evaluate, but never
# modify production policy without an explicit policy_promote call.
GPU_LAB_POLICY_AUTO_EVALUATE=true
GPU_LAB_POLICY_AUTO_REJECT=true
GPU_LAB_POLICY_AUTO_REVISE=true
GPU_LAB_POLICY_AUTO_PROMOTE_PRODUCTION=false
GPU_LAB_POLICY_MAX_REVISIONS=1
GPU_LAB_POLICY_AUTONOMY_MODE=AUTO_PROJECT
GPU_LAB_POLICY_META_CANDIDATE_BUDGET=3
GPU_LAB_POLICY_META_BENCHMARK_BUDGET=6
GPU_LAB_POLICY_META_LITERATURE_BUDGET=1
GPU_LAB_SSH_ALLOW_UNVERIFIED_HOSTS=false
GPU_LAB_SSH_KNOWN_HOSTS=
GPU_LAB_SSH_PRIVATE_KEY_PATH=
GPU_LAB_SSH_TIMEOUT=20
GPU_LAB_TERMINAL_PASSWORD=
# Only the isolated literature service receives these optional provider credentials.
OPENAI_API_KEY=
POSTGRES_PASSWORD=
# Private Chucky Lab cockpit. Keep LAB_UI_ENABLED=false until both values are set.
LAB_UI_ENABLED=false
GPU_LAB_COCKPIT_PASSWORD=
GPU_LAB_COCKPIT_SESSION_SECRET=
CHATGPT_WEB_BRIDGE_ENABLED=false
AUTOPILOT_ENABLED=false
AUTO_CONTINUE_ENABLED=false
LIVE_BROWSER_PREVIEW_ENABLED=false
# Server-side persistent profile; never mount or expose this in the frontend.
CHATGPT_WEB_PROFILE_ROOT=/var/lib/gpu-lab/chatgpt-web
SEMANTIC_SCHOLAR_API_KEY=
VAST_API_KEY=
